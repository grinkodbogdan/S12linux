#!/bin/sh
# Installs Badwolf, a light web browser with a modern engine (WebKitGTK, the engine of Safari and
# GNOME Web), from Void's repository, with what it needs to show full screen without a desktop of
# its own: the cage Wayland compositor, seatd and udev. About 250 MB of disk: S12 Linux has to be
# installed on the disk first (s12-install). Afterwards Menu > Web Browser starts it; NetSurf
# stays available as "netsurf".
export PATH=/usr/bin:/bin
if [ "$(awk '$2 == "/" { print $3 }' /proc/mounts | tail -1)" = rootfs ]; then
	echo "The browser needs about 250 MB of disk: install S12 Linux on the disk first (s12-install)."
	exit 1
fi
xbps-install -Sy badwolf cage seatd eudev mesa-dri dejavu-fonts-ttf xkeyboard-config || exit 1
# Firefox, from an earlier version of this command, is too heavy for the S12
if [ -x /usr/bin/firefox ]; then
	echo
	echo "Removing Firefox, replaced by Badwolf..."
	xbps-remove -Ry firefox > /dev/null && echo "Firefox removed."
fi
echo
echo "Badwolf is installed: Menu > Web Browser. Ctrl+L: address, Ctrl+T: new tab, Alt+D: close"
echo "the tab, the x at the top right: back to the desktop."
