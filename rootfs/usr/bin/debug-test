#!/bin/sh
# Tests the hardware of the IdeaPad S12: lists the devices the laptop has, tells which ones work,
# checks that both processor threads run, and writes everything needed to debug the rest.
#
# usage: debug-test            runs everything, without questions
#        debug-test --upload   uploads the last log to termbin.com and prints its link
#
# The log is written to /root/debug-test.txt, and to every USB stick or SD card with an ext2,
# ext4 or FAT partition.

LOG=/root/debug-test.txt
if [ "$1" = "--upload" ]; then
	[ -s $LOG ] || { echo "No log yet: run debug-test first."; exit 1; }
	echo "Uploading $LOG to termbin.com (the page is public, it holds hardware details only)..."
	URL=$(nc termbin.com 9999 < $LOG | tr -d '\0\r\n ')
	if [ -n "$URL" ]; then
		echo "Link: $URL"
		echo "$URL" > /root/debug-test-url.txt
	else
		echo "The upload failed: is the network cable plugged in? (see 'cat /run/net/status')"
	fi
	exit 0
fi
PASS=0
FAIL=0
FAILED=""

say() { echo "$*" | tee -a $LOG; }
ok() { PASS=$((PASS + 1)); say "[ OK ] $1${2:+: $2}"; }
bad() { FAIL=$((FAIL + 1)); FAILED="$FAILED
  - $1"; say "[FAIL] $1${2:+: $2}"; }
na() { say "[ -- ] $1${2:+: $2}"; }
title() { say ""; say "===== $1"; }
# Runs a command, for the log only
logcmd() { printf '\n----- %s\n' "$*" >> $LOG; "$@" >> $LOG 2>&1; }
read_file() { [ -r "$1" ] && cat "$1" 2>/dev/null; }
first() { for f in "$@"; do [ -e "$f" ] && { echo "$f"; return; }; done; }

# Copies the log to every partition of the USB sticks and SD cards that can be mounted
save_usb() {
	SAVED=""
	mkdir -p /mnt/debug-test
	for p in /dev/sd?[0-9] /dev/mmcblk?p[0-9]; do
		[ -e "$p" ] || continue
		grep -q "^$p " /proc/mounts && continue
		if mount "$p" /mnt/debug-test 2>/dev/null; then
			# Skip read-only media, such as the boot stick
			if cp $LOG /mnt/debug-test/s12-debug-test.txt 2>/dev/null; then
				SAVED="$SAVED $p"
			fi
			umount /mnt/debug-test
		fi
	done
	[ -n "$SAVED" ] && echo "Log saved as s12-debug-test.txt on$SAVED"
}

: > $LOG
say "S12 Linux debug test, $(date)"
say "$(uname -a)"
say "Kernel command line: $(read_file /proc/cmdline)"
DMESG=$(dmesg 2>/dev/null)
# PCI devices as "slot vendor:device class driver"
PCI=$(for d in /sys/bus/pci/devices/*; do
	v=$(cat $d/vendor); i=$(cat $d/device); c=$(cat $d/class)
	drv=$(basename "$(readlink $d/driver)" 2>/dev/null)
	echo "${d##*/} ${v#0x}:${i#0x} class ${c#0x} ${drv:-no-driver}"
done)
has_pci() { echo "$PCI" | grep -q " $1 "; }
pci_driver() { echo "$PCI" | grep " $1 " | head -1 | awk '{ print $5 }'; }

# ---------------------------------------------------------------------------------------------
title "Devices of the IdeaPad S12 (Intel), and their drivers"
expect() {
	if has_pci $1; then
		say "       present  $1  $2  (driver: $(pci_driver $1))"
	else
		say "       MISSING  $1  $2"
	fi
}
expect 8086:27ac "945GSE host bridge"
expect 8086:27ae "GMA 950 graphics"
expect 8086:27d8 "HD Audio"
expect 8086:27c8 "USB 1.1 controller 1 (UHCI)"
expect 8086:27c9 "USB 1.1 controller 2 (UHCI)"
expect 8086:27ca "USB 1.1 controller 3 (UHCI)"
expect 8086:27cb "USB 1.1 controller 4 (UHCI)"
expect 8086:27cc "USB 2.0 controller (EHCI)"
expect 8086:27b9 "ICH7-M LPC bridge (keyboard, touchpad, battery, fan)"
expect 8086:27da "SMBus (memory modules)"
expect 14e4:1713 "Broadcom BCM5906M Ethernet"
SATA=$(echo "$PCI" | grep ' 8086:27c[0-6] ' | head -1)
if [ -n "$SATA" ]; then
	say "       present  $(echo $SATA | cut -d' ' -f2)  SATA controller (driver: $(echo $SATA | awk '{ print $5 }'))"
else
	say "       MISSING  8086:27c4  SATA controller (hard disk)"
fi
WIFI=$(echo "$PCI" | grep -i ' 14e4:43[0-9a-f][0-9a-f] \| 168c:\| 8086:42\| 8086:08' | head -1)
[ -n "$WIFI" ] && say "       present  $(echo $WIFI | cut -d' ' -f2)  Wi-Fi card (driver: $(echo $WIFI | awk '{ print $5 }'))"
say ""
say "All PCI devices:"
echo "$PCI" | while read line; do say "       $line"; done

# ---------------------------------------------------------------------------------------------
title "Checks"
MEM=$(awk '/MemTotal/ { print int($2 / 1024) " MB" }' /proc/meminfo)
USED=$(awk '/MemTotal/ { t = $2 } /MemAvailable/ { a = $2 } END { print int((t - a) / 1024) " MB in use" }' /proc/meminfo)
[ -n "$MEM" ] && ok "Memory" "$MEM, $USED" || bad "Memory" "cannot read /proc/meminfo"
YEAR=$(date +%Y)
if [ "$YEAR" -ge 2024 ] 2>/dev/null; then
	ok "Clock" "$(date)"
else
	bad "Clock" "$(date): set the date in the BIOS, secure sites need it"
fi

# Processor
MODEL=$(grep -m1 'model name' /proc/cpuinfo | sed 's/.*: //')
[ -n "$MODEL" ] && ok "Processor" "$MODEL" || bad "Processor" "unknown"
THREADS=$(grep -c '^processor' /proc/cpuinfo)
ONLINE=$(read_file /sys/devices/system/cpu/online)
if [ "$THREADS" -ge 2 ]; then
	ok "Processor threads" "$THREADS running (cpus $ONLINE)"
else
	bad "Processor threads" "only $THREADS running (cpus $ONLINE): $(echo "$DMESG" | grep -i 'smp\|smpboot\|APIC' | tail -3 | tr '\n' ' ')"
fi
CF=/sys/devices/system/cpu/cpu0/cpufreq
if [ -r $CF/scaling_cur_freq ]; then
	ok "Speed scaling" "$(($(cat $CF/scaling_cur_freq) / 1000)) MHz ($(($(cat $CF/scaling_min_freq) / 1000))-$(($(cat $CF/scaling_max_freq) / 1000))), $(cat $CF/scaling_driver), $(cat $CF/scaling_governor)"
else
	bad "Speed scaling" "no cpufreq driver: $(echo "$DMESG" | grep -i 'cpufreq\|speedstep' | tail -2 | tr '\n' ' ')"
fi
IDLE=$(read_file /sys/devices/system/cpu/cpuidle/current_driver)
[ -n "$IDLE" ] && [ "$IDLE" != none ] && ok "Idle states" "$IDLE, $(ls -d /sys/devices/system/cpu/cpu0/cpuidle/state* 2>/dev/null | wc -l) states" || na "Idle states" "none"
TEMP=""
for h in /sys/class/hwmon/hwmon*; do
	[ "$(cat $h/name 2>/dev/null)" = coretemp ] && TEMP=$(cat $h/temp*_input 2>/dev/null | head -1)
done
[ -z "$TEMP" ] && TEMP=$(read_file /sys/class/thermal/thermal_zone0/temp)
if [ -n "$TEMP" ] && [ "$TEMP" -gt 10000 ] && [ "$TEMP" -lt 105000 ]; then
	ok "Temperature" "$((TEMP / 1000)) C"
elif [ -n "$TEMP" ]; then
	bad "Temperature" "unlikely value $TEMP"
else
	bad "Temperature" "no sensor"
fi

# Display
if has_pci 8086:27ae; then
	if [ "$(pci_driver 8086:27ae)" = i915 ]; then
		ok "Graphics driver (GMA 950)" "i915"
	else
		bad "Graphics driver (GMA 950)" "$(echo "$DMESG" | grep -i 'i915\|drm' | tail -3 | tr '\n' ' ')"
	fi
else
	na "Graphics driver (GMA 950)" "no GMA 950 on this machine"
fi
[ -e /dev/fb0 ] && ok "Framebuffer" "$(read_file /sys/class/graphics/fb0/name | tr -d '\n') $(read_file /sys/class/graphics/fb0/virtual_size)" || bad "Framebuffer" "no /dev/fb0"
OUTPUTS=""
for c in /sys/class/drm/card*-*; do
	[ -e $c/status ] || continue
	OUTPUTS="$OUTPUTS ${c##*/card?-} $(cat $c/status)$([ -s $c/modes ] && echo " $(head -1 $c/modes)")"
done
[ -n "$OUTPUTS" ] && ok "Displays" "$OUTPUTS"
BL=$(first /sys/class/backlight/intel_backlight /sys/class/backlight/acpi_video0 /sys/class/backlight/*)
if [ -n "$BL" ] && [ -r $BL/brightness ]; then
	B=$(cat $BL/brightness)
	if echo "$B" > $BL/brightness 2>/dev/null; then
		ok "Brightness" "${BL##*/}: $B of $(cat $BL/max_brightness)"
	else
		bad "Brightness" "${BL##*/} cannot be set"
	fi
else
	bad "Brightness" "no backlight control"
fi

# Input
INPUT=$(grep '^N: Name=' /proc/bus/input/devices | sed 's/N: Name=//; s/"//g')
echo "$INPUT" | grep -qi 'AT Translated\|keyboard' && ok "Keyboard" "$(echo "$INPUT" | grep -i 'AT Translated\|keyboard' | head -1)" || bad "Keyboard" "not detected"
TP=$(echo "$INPUT" | grep -i 'touchpad\|synaptics\|alps\|elantech\|mouse' | head -1)
[ -n "$TP" ] && ok "Touchpad" "$TP" || bad "Touchpad" "not detected"
echo "$INPUT" | grep -qi 'power button' && ok "Power button" || bad "Power button" "not detected"

# USB
USB=""
for k in 00:UHCI 10:OHCI 20:EHCI 30:xHCI; do
	N=$(echo "$PCI" | grep -c "class 0c03${k%%:*} ")
	[ "$N" -gt 0 ] && USB="$USB $N ${k#*:}"
done
NOUSBDRV=$(echo "$PCI" | grep "class 0c03" | grep -c no-driver)
if [ -z "$USB" ]; then
	bad "USB controllers" "none found"
elif [ "$NOUSBDRV" -gt 0 ]; then
	bad "USB controllers" "$USB, $NOUSBDRV without a driver"
else
	ok "USB controllers" "$USB"
fi
USBDEV=$(for d in /sys/bus/usb/devices/[0-9]*-[0-9]*; do
	[ -e $d/idVendor ] && echo "$(cat $d/idVendor):$(cat $d/idProduct) $(cat $d/product 2>/dev/null)"
done | tr '\n' ';')
[ -n "$USBDEV" ] && say "       USB devices: $USBDEV"

# Storage
DISKS=""
for b in /sys/block/sd* /sys/block/mmcblk*; do
	[ -e $b ] || continue
	DISKS="$DISKS ${b##*/} $(($(cat $b/size) / 2048)) MB"
done
[ -n "$DISKS" ] && ok "Disks" "$DISKS" || na "Disks" "none found"
if has_pci 8086:27c4 || has_pci 8086:27c5 || has_pci 8086:27c6; then
	ls /sys/block | grep -q '^sd' || bad "Hard disk" "the SATA controller has no disk: $(echo "$DMESG" | grep -i 'ata[0-9]' | tail -2 | tr '\n' ' ')"
fi

# Sound
CARDS=$(read_file /proc/asound/cards)
if [ -e /dev/dsp ] && [ -n "$CARDS" ]; then
	CODEC=$(cat /proc/asound/card0/codec#* 2>/dev/null | grep -m1 '^Codec:' | sed 's/Codec: //')
	ok "Sound" "$(echo "$CARDS" | head -1 | sed 's/^ *0 \[[^]]*\]: //'), codec ${CODEC:-unknown}"
elif has_pci 8086:27d8; then
	bad "Sound" "no sound card: $(echo "$DMESG" | grep -i 'hda\|snd' | tail -2 | tr '\n' ' ')"
else
	na "Sound" "no sound card"
fi

# Power
PS=/sys/class/power_supply
BAT=$(first $PS/BAT0 $PS/BAT1)
if [ -n "$BAT" ] && [ "$(read_file $BAT/present)" = 1 ]; then
	ok "Battery" "$(read_file $BAT/capacity)% $(read_file $BAT/status), $(read_file $BAT/model_name) $(read_file $BAT/technology)"
else
	bad "Battery" "not found"
fi
AC=$(first $PS/AC $PS/AC0 $PS/ADP1 $PS/ACAD)
[ -n "$AC" ] && ok "AC adapter" "$([ "$(cat $AC/online)" = 1 ] && echo plugged || echo unplugged)" || bad "AC adapter" "not found"
LID=$(first /proc/acpi/button/lid/*/state)
[ -n "$LID" ] && ok "Lid switch" "$(cat $LID | tr -s ' ')" || { echo "$INPUT" | grep -qi lid && ok "Lid switch" || bad "Lid switch" "not found"; }
FAN=$(ls -d /sys/class/thermal/cooling_device* 2>/dev/null | wc -l)
say "       Cooling devices: $FAN; thermal zones: $(ls -d /sys/class/thermal/thermal_zone* 2>/dev/null | wc -l)"

# Network
NET=$(read_file /run/net/status | grep '^eth')
if [ -z "$NET" ]; then
	bad "Ethernet card" "no driver started: $(echo "$DMESG" | grep -i 'tg3\|eth' | tail -3 | tr '\n' ' ')"
else
	ok "Ethernet card" "$(echo "$NET" | head -1 | cut -d' ' -f1-3)"
	if echo "$NET" | grep -q 'link up'; then
		ok "Ethernet link" "cable connected, $(echo "$NET" | grep -o '[0-9]*Mb/s' | head -1)"
		ADDR=$(echo "$NET" | grep -o 'inet [0-9./]*' | head -1)
		GW=$(echo "$NET" | grep -o 'gateway [0-9.]*' | head -1 | cut -d' ' -f2)
		if [ -z "$ADDR" ]; then
			# DHCP may still be running just after boot
			sleep 6
			NET=$(read_file /run/net/status | grep '^eth')
			ADDR=$(echo "$NET" | grep -o 'inet [0-9./]*' | head -1)
			GW=$(echo "$NET" | grep -o 'gateway [0-9.]*' | head -1 | cut -d' ' -f2)
		fi
		if [ -n "$ADDR" ]; then
			ok "Address (DHCP)" "$ADDR, gateway $GW"
			if [ -n "$GW" ] && ping -c 2 -W 2 "$GW" > /dev/null 2>&1; then
				ok "Ping the router" "$GW"
			else
				bad "Ping the router" "$GW does not answer"
			fi
			if nslookup example.com > /dev/null 2>&1; then
				ok "Name lookup (DNS)" "$(read_file /etc/resolv.conf | tr '\n' ' ')"
			else
				bad "Name lookup (DNS)" "example.com not found"
			fi
			if wget -q -T 15 -O /dev/null http://example.com/ 2>/dev/null; then
				ok "Web (http)"
			else
				bad "Web (http)" "http://example.com does not load"
			fi
			if curl -s -m 20 -o /dev/null https://example.com/ 2>/dev/null; then
				ok "Secure web (https)"
			else
				bad "Secure web (https)" "$(curl -sS -m 20 -o /dev/null https://example.com/ 2>&1 | head -1)"
			fi
		else
			bad "Address (DHCP)" "no address from the router"
		fi
	else
		na "Ethernet link" "no cable: network not tested"
	fi
fi
[ -n "$WIFI" ] && na "Wi-Fi" "not supported yet"

# Dual core: both threads must do work. Two busy loops for 3 seconds, then the busy time of
# each thread from /proc/stat (user + system, in hundredths of a second)
if [ "$THREADS" -ge 2 ]; then
	B0=$(awk '/^cpu[0-9]/ { printf "%d ", $2 + $4 }' /proc/stat)
	(end=$(($(date +%s) + 3)); while [ $(date +%s) -lt $end ]; do :; done) &
	L1=$!
	(end=$(($(date +%s) + 3)); while [ $(date +%s) -lt $end ]; do :; done) &
	L2=$!
	wait $L1 $L2
	B1=$(awk '/^cpu[0-9]/ { printf "%d ", $2 + $4 }' /proc/stat)
	WORK=""
	LAZY=0
	i=0
	for b in $B1; do
		a=$(echo $B0 | cut -d' ' -f$((i + 1)))
		d=$((b - a))
		WORK="$WORK cpu$i ${d}0 ms"
		[ $d -lt 100 ] && LAZY=1
		i=$((i + 1))
	done
	[ $LAZY = 0 ] && ok "Dual core under load" "busy time over 3 s:$WORK" || bad "Dual core under load" "one thread does little work:$WORK"
fi

# ---------------------------------------------------------------------------------------------
say ""
say "===== $PASS working, $FAIL not working$FAILED"

# Everything, for debugging
for f in /proc/cpuinfo /proc/meminfo /proc/stat /proc/interrupts /proc/iomem /proc/ioports \
	/proc/bus/input/devices /proc/asound/cards /proc/mounts /run/net/status /etc/resolv.conf \
	/proc/cmdline /proc/version; do
	logcmd cat $f
done
logcmd ip addr
logcmd ip route
logcmd free
logcmd df
logcmd ps
logcmd ls -l /dev /dev/input /dev/dri /dev/snd
for c in /proc/asound/card*/codec#*; do [ -e "$c" ] && logcmd cat "$c"; done
printf '\n----- /sys\n' >> $LOG
for t in class/power_supply class/backlight class/thermal class/hwmon class/drm class/net class/graphics \
	devices/system/cpu bus/pci/devices bus/usb/devices; do
	find /sys/$t/ -maxdepth 3 -type f 2>/dev/null | while read f; do
		case "$f" in */uevent | */power/* | */config | */rom | */resource* | */edid | */*_bin) continue ;; esac
		v=$(head -c 200 "$f" 2>/dev/null | tr '\n' ' ')
		[ -n "$v" ] && printf '%s: %s\n' "$f" "$v" >> $LOG
	done
done
printf '\n----- dmesg\n%s\n' "$DMESG" >> $LOG
save_usb
echo ""
echo "The full log is $LOG ($(wc -c < $LOG) bytes)."
echo "To share it: plug a network cable and run 'debug-test --upload', or plug a USB stick and"
echo "run debug-test again, or take photos of the screen."
