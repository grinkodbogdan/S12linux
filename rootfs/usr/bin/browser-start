#!/bin/sh
# Starts Badwolf full screen, in the cage Wayland compositor (install-browser installs them).
export PATH=/usr/bin:/bin
# udev keeps the list of devices that the compositor and libinput look for
if ! pgrep -x udevd > /dev/null; then
	udevd --daemon
	udevadm trigger --action=add
	udevadm settle -t 10
fi
# seatd gives the compositor the screen and the input devices
if ! pgrep -x seatd > /dev/null; then
	seatd -g root > /dev/null 2>&1 &
	sleep 1
fi
export XDG_RUNTIME_DIR=/run/user/0
mkdir -p $XDG_RUNTIME_DIR
chmod 700 $XDG_RUNTIME_DIR
export LIBSEAT_BACKEND=seatd
# The GMA 950's OpenGL is too old for the compositor and WebKit's GPU paths: the processor draws
export WLR_RENDERER=pixman
export WLR_NO_HARDWARE_CURSORS=1
export GDK_BACKEND=wayland
export WEBKIT_DISABLE_COMPOSITING_MODE=1
export WEBKIT_DISABLE_DMABUF_RENDERER=1
# -S: JavaScript on (Badwolf starts with it off, and most sites need it; the JS button toggles it)
exec cage -s -- badwolf -S "${@:-https://html.duckduckgo.com/html/}"
