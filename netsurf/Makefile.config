# NetSurf build settings for S12 Linux (i686, static, framebuffer). build.sh copies this file to
# netsurf/Makefile.config and adds the paths of the libraries it built.
override NETSURF_FB_FRONTEND := linux
override NETSURF_FB_FONTLIB := freetype
override NETSURF_FB_FONTPATH := /usr/share/fonts
override NETSURF_FB_RESPATH := $${HOME}/.netsurf/:/usr/share/netsurf
override NETSURF_FB_FONT_SANS_SERIF_ITALIC := DejaVuSans-Oblique.ttf
override NETSURF_FB_FONT_SANS_SERIF_ITALIC_BOLD := DejaVuSans-BoldOblique.ttf
override NETSURF_FB_FONT_CURSIVE := DejaVuSerif-Italic.ttf
override NETSURF_FB_FONT_FANTASY := DejaVuSans-Bold.ttf
override NETSURF_USE_JPEGXL := NO
override NETSURF_USE_WEBP := NO
override NETSURF_USE_VIDEO := NO
override NETSURF_USE_LIBICONV_PLUG := NO
override NETSURF_LOG_LEVEL := WARNING
override NETSURF_UA_FORMAT_STRING := "Mozilla/5.0 (%s) NetSurf/%d.%d"
override NETSURF_HOMEPAGE := "about:welcome"
