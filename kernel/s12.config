# Kernel options for the Lenovo IdeaPad S12 (Intel): Atom N270, 945GSE + ICH7-M, GMA 950,
# Broadcom BCM5906M Ethernet, HD Audio. Applied on top of i386_defconfig; everything is built in.
CONFIG_LOCALVERSION="-s12"
CONFIG_DEFAULT_HOSTNAME="s12"
CONFIG_MODULES=n
CONFIG_KERNEL_XZ=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_DEBUG_INFO_NONE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_INITRAMFS_PRESERVE_MTIME=n
CONFIG_IKCONFIG=n
CONFIG_AUDIT=n
CONFIG_PROFILING=n
CONFIG_KPROBES=n
CONFIG_FTRACE=n
CONFIG_SECURITY=n
CONFIG_SECURITY_SELINUX=n
CONFIG_BPF_SYSCALL=n
CONFIG_CGROUPS=n
CONFIG_NAMESPACES=n
CONFIG_HIBERNATION=n
CONFIG_SUSPEND=y
CONFIG_KEXEC=n
CONFIG_CRASH_DUMP=n
CONFIG_RELOCATABLE=n
CONFIG_RANDOMIZE_BASE=n
CONFIG_MICROCODE=y
CONFIG_X86_MCE=n
CONFIG_PERF_EVENTS=y

# Processor: Atom N270, one core with two threads
CONFIG_MATOM=y
CONFIG_X86_GENERIC=n
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_SCHED_SMT=y
CONFIG_HIGHMEM4G=y
CONFIG_X86_PAE=n
CONFIG_HZ_250=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_X86_ACPI_CPUFREQ=y
CONFIG_CPU_IDLE=y
CONFIG_INTEL_IDLE=y

# ACPI: battery, AC adapter, lid and power buttons, fan, thermal zones, backlight
CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_VIDEO=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_EC=y
CONFIG_THERMAL=y
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# Buses
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_I2C=y
CONFIG_I2C_I801=y
CONFIG_I2C_CHARDEV=y
CONFIG_EEPROM_AT24=y

# Storage: internal SATA disk, USB sticks, SD cards in USB readers
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_GENERIC=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_XHCI_HCD=n
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_RICOH_MMC=y
CONFIG_MMC_BLOCK=y

# File systems
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_EXFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_AUTOFS_FS=n
CONFIG_QUOTA=n

# Input: keyboard and touchpad on PS/2, USB keyboards and mice
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_MOUSEDEV_SCREEN_X=1024
CONFIG_INPUT_MOUSEDEV_SCREEN_Y=600
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_INPUT_JOYSTICK=n
CONFIG_INPUT_TABLET=n
CONFIG_INPUT_TOUCHSCREEN=n
# Virtual input devices: tpd turns the touchpad into a mouse with a scroll wheel
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y

# Graphics: GMA 950 (i915), with the BIOS framebuffer as fallback, and Bochs for emulators
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_RADEON=n
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_VIRTIO_GPU=n
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_LOGO=n

# Sound: HD Audio with OSS emulation (/dev/dsp, /dev/mixer)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_ALC269=y
CONFIG_SND_HDA_CODEC_ALC662=y
CONFIG_SND_HDA_CODEC_SIGMATEL=y
CONFIG_SND_HDA_CODEC_ANALOG=y
CONFIG_SND_HDA_CODEC_HDMI=n
CONFIG_SND_OSSEMUL=y
CONFIG_SND_PCM_OSS=y
CONFIG_SND_MIXER_OSS=y
CONFIG_SND_USB=n
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=10

# Network: BCM5906M (tg3), Intel e1000 for emulators
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=y
CONFIG_TIGON3_HWMON=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=n
CONFIG_NETFILTER=n
CONFIG_NET_SCHED=n
CONFIG_BRIDGE=n
CONFIG_WAN=n
CONFIG_INFINIBAND=n
CONFIG_NFS_FS=n
CONFIG_NETWORK_FILESYSTEMS=n

# USB network adapters and phone tethering (RNDIS for Android, CDC for others)
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_RTL8152=y

# Wi-Fi. The S12's card is usually a Broadcom BCM4312 (b43, LP-PHY: its firmware is installed
# at run time by wifi-firmware), sometimes an Intel 5100 or an Atheros card. USB dongles with
# free firmware: Ralink/MediaTek rt2800, Realtek rtl8xxxu and rtl8187, Atheros ath9k_htc.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_DEFAULT_PS=y
CONFIG_CFG80211_CRDA_SUPPORT=y
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=y
CONFIG_CFG80211_WEXT=n
CONFIG_MAC80211=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_LEDS=y
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_SSB=y
CONFIG_SSB_PCIHOST=y
CONFIG_BCMA=y
CONFIG_BCMA_HOST_PCI=y
CONFIG_B43=y
CONFIG_B43_SSB=y
CONFIG_B43_BCMA=y
CONFIG_B43_PHY_G=y
CONFIG_B43_PHY_LP=y
CONFIG_B43_PHY_N=y
CONFIG_B43_LEDS=y
CONFIG_B43_HWRNG=n
CONFIG_B43LEGACY=n
CONFIG_BRCMSMAC=n
CONFIG_BRCMFMAC=n
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=y
CONFIG_IWLDVM=y
CONFIG_IWLMVM=n
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH5K=y
CONFIG_ATH9K=y
CONFIG_ATH9K_PCI=y
CONFIG_ATH9K_HTC=y
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=y
CONFIG_RTL8187=y
CONFIG_RTL_CARDS=n
CONFIG_WLAN_VENDOR_MEDIATEK=n
CONFIG_WLAN_VENDOR_MARVELL=n
CONFIG_WLAN_VENDOR_ATMEL=n
CONFIG_WLAN_VENDOR_ZYDAS=n
CONFIG_WLAN_VENDOR_INTERSIL=n
CONFIG_WLAN_VENDOR_TI=n
CONFIG_WLAN_VENDOR_QUANTENNA=n
CONFIG_WLAN_VENDOR_MICROCHIP=n
CONFIG_WLAN_VENDOR_PURELIFI=n
CONFIG_WLAN_VENDOR_RSI=n
CONFIG_WLAN_VENDOR_SILABS=n
CONFIG_WLAN_VENDOR_ST=n
CONFIG_MAC80211_HWSIM=n

# Lenovo IdeaPad: the Wi-Fi switch (rfkill), hotkeys and the camera switch
CONFIG_X86_PLATFORM_DEVICES=y
CONFIG_IDEAPAD_LAPTOP=y

# Console on the serial port too, for emulators
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_SOUND_OSS_CORE=n
CONFIG_AGP=y
CONFIG_AGP_INTEL=y
