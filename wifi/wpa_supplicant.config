# wpa_supplicant build options: nl80211 driver, WPA/WPA2 personal and enterprise, with the
# internal TLS and crypto code to keep it small (no WPA3-only networks: SAE needs OpenSSL).
# Options are on when defined, even as "n": leave out what is not wanted.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_INTERNAL_LIBTOMMATH_FAST=y
CONFIG_IEEE8021X_EAPOL=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_GTC=y
CONFIG_EAP_TLS=y
CONFIG_EAP_MD5=y
CONFIG_PKCS12=y
CONFIG_IEEE80211W=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211AC=y
CONFIG_BGSCAN_SIMPLE=y
CONFIG_AUTOSCAN_EXPONENTIAL=y
CONFIG_NO_RANDOM_POOL=y
